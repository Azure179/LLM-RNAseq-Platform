# Optional: copy outside source folders into an ignored local .env file.
# docker compose --env-file <your-private-file> ...
# Ordinary deployment settings; published addresses remain localhost only.
RNASEQ_IMAGE=bulk-rnaseq:local
RNASEQ_VOLUME_NAME=rnaseq-workspace
RNASEQ_API_PUBLISHED_PORT=8000
RNASEQ_UI_PUBLISHED_PORT=8501
RNASEQ_LOG_LEVEL=INFO
# For compose.bind.yaml, use an existing absolute host directory.
# Windows accepts forward slashes; spaces are supported by the long mount syntax.
# RNASEQ_WORKSPACE_HOST=C:/RNAseq Workspace

# Runtime credential; leave empty for non-AI API analysis and Results browsing.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_TOKENS=64
