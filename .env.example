# Copy to .env and enter your OWN key locally. Never commit/share .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_TOKENS=64

# Service settings are PROCESS environment variables (PowerShell $env:NAME=...).
# The DeepSeek .env loader does not export these into the process environment.
# RNASEQ_WORKSPACE_ROOT=workspace
# RNASEQ_RSCRIPT=Rscript
# RNASEQ_LOG_LEVEL=INFO
# UVICORN_HOST=127.0.0.1
# UVICORN_PORT=8000
# STREAMLIT_SERVER_ADDRESS=127.0.0.1
# STREAMLIT_SERVER_PORT=8501
